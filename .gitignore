# Large downloaded data stays out of the repo.
# The Met dataset alone is 318 MB, and GitHub rejects files over 100 MB.
data/
*.csv
personas/*/sources/

# Python
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/

# Secrets such as API keys
.env

# Request logs contain visitors' questions. Anonymized extracts go in artifacts/evidence/.
logs/

# Model weights and audio caches
models/
*.wav
# ...except the sound effects an exhibit can play, which are part of its config
!personas/*/sounds/*.wav
*.mp3
*.webm

# OS and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
