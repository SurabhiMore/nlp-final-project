# Copy this file to .env and fill it in. Never commit .env (it is in .gitignore).

# ---- Language model (answers questions) -------------------------------------
# Any service with an OpenAI-compatible chat completions endpoint works.
# Pick one base URL, put your key in LLM_API_KEY, and copy a model name from the
# provider's current model list (model names change, so check their site).
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.2
# LLM_TIMEOUT=60          seconds to wait for one answer
# LLM_REASONING_EFFORT=low   for reasoning models (gpt-oss): faster, and far fewer tokens

# Base URLs:
#   Groq (free tier)          https://api.groq.com/openai/v1
#                             e.g. LLM_MODEL=openai/gpt-oss-120b with LLM_REASONING_EFFORT=low.
#                             One question uses about 2,800 tokens; check your daily limit.
#   Google AI Studio (free)   https://generativelanguage.googleapis.com/v1beta/openai
#   Ollama on your laptop     http://localhost:11434/v1        (no key needed)
#
# To test everything else without a model: LLM_PROVIDER=offline

# ---- Speech to text (optional) ---------------------------------------------
# Default is "base" on a CPU and "large-v3-turbo" on a GPU.
# WHISPER_MODEL=base
# WHISPER_DEVICE=cpu

# ---- Server (optional) -------------------------------------------------------
# PRELOAD_MODELS=1        load Whisper and Kokoro at startup instead of on first use
# TOP_K=8                 passages given to the language model per question

# ---- Data (optional) ---------------------------------------------------------
# Smithsonian Open Access key for building the T. rex corpus. DEMO_KEY works for
# small runs; a free key comes from https://api.data.gov/signup/
# SI_API_KEY=
